{
  "name": "vyva-whatsapp",
  "version": "0.0.1",
  "description": "Vyva WhatsApp API - conversations, webhook, and outbound messages",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "npx prettier --write \"src/**/*.ts\"",
    "start": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "logs:qas": "serverless logs -t -f api --stage qas",
    "logs:prd": "serverless logs -t -f api --stage prd",
    "deploy:qas": "nest build && serverless deploy function -f api --stage qas",
    "deploy:prd": "nest build && serverless deploy function -f api --stage prd",
    "deploy:all": "nest build && serverless deploy function -f api --stage qas && serverless deploy function -f api --stage prd",
    "deploy:qas:force": "nest build && serverless deploy --stage qas",
    "deploy:prd:force": "nest build && serverless deploy --stage prd",
    "deploy:all:force": "nest build && serverless deploy --stage qas && serverless deploy --stage prd"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@types/express": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "aws-lambda": "^1.0.7",
    "aws-serverless-express": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "crypto-js": "^4.2.0",
    "dynamoose": "^4.0.4",
    "joi": "^17.13.3",
    "nestjs-dynamoose": "^0.6.0",
    "reflect-metadata": "^0.1.14",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/aws-serverless-express": "^3.3.10",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.46",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "typescript": "^5.8.3"
  }
}
